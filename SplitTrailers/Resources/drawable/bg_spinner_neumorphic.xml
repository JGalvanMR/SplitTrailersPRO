<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="androidx.appcompat.graphics.drawable">

    <!-- Sombra inferior derecha (oscura) -->
    <item
        android:left="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Sombra superior izquierda (clara) -->
    <item
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Fondo principal -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_secondary" />
            <stroke android:width="1dp" android:color="#CCCCCC" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>