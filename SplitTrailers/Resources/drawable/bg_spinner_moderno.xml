<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Estado presionado / tocado -->
	<item android:state_pressed="true">
		<shape>
			<solid android:color="@color/md_theme_surfaceContainerHigh" />
			<stroke android:width="1dp" android:color="@color/md_theme_outline" />
			<corners android:radius="12dp" />
		</shape>
	</item>

	<!-- Estado enfocado / seleccionado -->
	<item android:state_focused="true">
		<shape>
			<solid android:color="@color/md_theme_surfaceContainerLow" />
			<stroke android:width="1dp" android:color="@color/md_theme_primary" />
			<corners android:radius="12dp" />
		</shape>
	</item>

	<!-- Estado normal -->
	<item>
		<shape>
			<solid android:color="@color/md_theme_surfaceContainer" />
			<stroke android:width="1dp" android:color="@color/md_theme_outline" />
			<corners android:radius="12dp" />
		</shape>
	</item>

</selector>
