<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <TextView
        android:id="@+id/textoprincipal"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Terminar Lectura de Orden" />

    <TextView
        android:id="@+id/textosecundario"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pedidos Activos:"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/pedidosactivos"
        style="@style/spinner_moderno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonTerminarCarga"
        style="@style/btn_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Terminar Carga"
        android:stateListAnimator="@animator/button_elevation_anim" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonreasignar"
        style="@style/btn_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reasignar"
        android:stateListAnimator="@animator/button_elevation_anim" />

    <TextView
        android:id="@+id/textView4"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DETALLE DE PRODUCTO:"
        android:layout_marginTop="12dp" />

    <androidx.cardview.widget.CardView
        style="@style/card_m3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <GridView
            android:id="@+id/gvCtrdetalle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="1"
            android:columnWidth="150dp"
            android:padding="8dp"
            android:clipToPadding="false" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textTOTALESCA"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000|000:"
        android:layout_marginTop="8dp"
        android:gravity="end" />
</LinearLayout>