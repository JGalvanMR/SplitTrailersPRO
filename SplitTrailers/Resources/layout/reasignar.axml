<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_marginTop="@dimen/marginTop">
	<TextView
        
		android:text="Terminar Lectura de Orden"
		style="@style/label_primary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/textoprincipal" />
	<TextView
        
		android:text="Pedidos Activos:"
		style="@style/label_primary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/textosecundario"
		android:singleLine="true"
		android:imeOptions="actionDone" />
	<Spinner
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/pedidosactivos"
        android:spinnerMode="dropdown"/>
	<Button
		android:text="Terminar Carga"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/buttonTerminarCarga"
		android:layout_marginTop="0.0dp"
		style="@style/btn_m3"
		android:stateListAnimator="@animator/button_elevation_anim"/>
	<Button
		android:text="Reasignar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/buttonreasignar"
		android:layout_marginTop="0.0dp"
		style="@style/btn_m3"
		android:stateListAnimator="@animator/button_elevation_anim"/>
	<TextView
        
		android:text="DETALLE DE PRODUCTO:"
		style="@style/label_primary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/textView4" />
	<GridView
		android:minWidth="25px"
		android:minHeight="25px"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:numColumns="1"
		android:id="@+id/gvCtrdetalle"
		android:layout_weight="1"
		android:columnWidth="150dp"
		style="@style/card_m3"/>
	<TextView
        
		android:text="000|000:"
		style="@style/label_primary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/textTOTALESCA" />
</LinearLayout>