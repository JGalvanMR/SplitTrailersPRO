<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <TextView
        android:id="@+id/usuarioInf"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usuario" />

    <TextView
        android:id="@+id/PedidoInf"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pedido:"
        android:singleLine="true"
        android:imeOptions="actionDone" />

    <TextView
        style="@style/label_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DETALLE DE PRODUCTO:"
        android:layout_marginTop="8dp" />

    <!-- Contenedor del GridView con estilo de card -->
    <androidx.cardview.widget.CardView
        style="@style/card_m3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <GridView
            android:id="@+id/gvCtrlInf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="1"
            android:columnWidth="150dp"
            android:padding="8dp"
            android:clipToPadding="false" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textTOTALESCA"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000|000:"
        android:layout_marginTop="8dp"
        android:gravity="end" />
</LinearLayout>