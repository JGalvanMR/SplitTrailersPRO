<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/marginTop">
	<TextView
        android:text="Productos En Split"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textView1"
        android:gravity="center" />
	<GridView
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:numColumns="1"
        android:id="@+id/gvCtrcapturasplit"
        android:layout_weight="1"
        android:columnWidth="150dp"
		style="@style/card_m3"/>
	<Button
        android:textSize="16sp"
        android:text="Cancelar Split Completo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btnbclose"
        android:layout_weight="0"
        android:drawableLeft="@drawable/cerrar"
		style="@style/btn_m3"
		android:stateListAnimator="@animator/button_elevation_anim"/>
</LinearLayout>