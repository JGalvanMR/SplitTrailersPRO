<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <CheckBox
        android:id="@+id/Eliminar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar Caja"
        android:textSize="16sp"
        android:buttonTint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/splitdiasmin"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DIAS MINIMOS DE CARGA:"
        android:gravity="right"
        android:singleLine="true" />

    <TextView
        android:id="@+id/splitcantidad"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SPLIT:"
        android:gravity="right"
        android:singleLine="true" />

    <TextView
        android:id="@+id/pedidoencaptura"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PEDIDO:"
        android:gravity="right"
        android:singleLine="true" />

    <RadioGroup
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:buttonTint="?attr/colorPrimary">

        <RadioButton
            android:id="@+id/radio_blanco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:checked="true"
            android:text="CAJAXCAJA"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/radio_verde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:text="TARIMA COMPLETA"
            android:textSize="16sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/textView12"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CODIGO:"
        android:singleLine="true"
        android:layout_marginTop="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/entry_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:placeholderText="Código">

        <EditText
            android:id="@+id/Folio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:background="@null" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/GuardarCapturado"
        style="@style/btn_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Grabar"
        android:stateListAnimator="@animator/button_elevation_anim" />

    <TextView
        android:id="@+id/totalcapturado"
        style="@style/label_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000"
        android:layout_marginTop="8dp" />

    <androidx.cardview.widget.CardView
        style="@style/card_m3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <GridView
            android:id="@+id/gvCtr2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="1"
            android:columnWidth="150dp"
            android:padding="8dp"
            android:clipToPadding="false" />
    </androidx.cardview.widget.CardView>
</LinearLayout>