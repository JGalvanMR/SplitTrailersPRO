<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <TextView
        android:id="@+id/pedidoencaptura"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PEDIDO:"
        android:gravity="right"
        android:singleLine="true" />

    <TextView
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CODIGO:"
        android:singleLine="true"
        android:layout_marginTop="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/entry_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:placeholderText="Código">

        <EditText
            android:id="@+id/FolioCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:background="@null" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/GuardarCancelado"
        style="@style/btn_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Liberar Cajas"
        android:stateListAnimator="@animator/button_elevation_anim" />

    <TextView
        android:id="@+id/totalcapturadocancelar"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000"
        android:layout_marginTop="8dp" />

    <androidx.cardview.widget.CardView
        style="@style/card_m3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <GridView
            android:id="@+id/gvCtrCanceladoParcial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="1"
            android:columnWidth="150dp"
            android:padding="8dp"
            android:clipToPadding="false" />
    </androidx.cardview.widget.CardView>
</LinearLayout>