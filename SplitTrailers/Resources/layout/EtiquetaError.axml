<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Folio -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/TextInputLayout_Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:placeholderText="Folio de la etiqueta">

        <EditText
            android:id="@+id/folio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@null" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textView1"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clave del Producto"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinner3"
        style="@style/spinner_moderno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/textView2"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Numero de Tarima"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/tarimareim"
        style="@style/spinner_moderno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/textView3"
        style="@style/label_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Numero de Caja"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/cajareim"
        style="@style/spinner_moderno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown" />

    <RadioGroup
        android:id="@+id/radioGroup1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:buttonTint="?attr/colorPrimary">
        <!-- Aquí se agregarán los RadioButtons desde código -->
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnsave"
        style="@style/btn_m3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="MANDAR A REIMPRESION"
        android:drawableLeft="@drawable/save"
        android:stateListAnimator="@animator/button_elevation_anim" />
</LinearLayout>