	<!-- ================== BOTONES ================== -->
	<style name="Widget.Material3.Button.Filled" parent="@style/Widget.Material3.Button.ElevatedButton">
		<item name="android:backgroundTint">@color/md_theme_primary</item>
		<item name="android:textColor">@color/md_theme_onPrimary</item>
		<item name="android:minHeight">48dp</item>
		<item name="android:paddingLeft">16dp</item>
		<item name="android:paddingRight">16dp</item>
		<item name="android:elevation">2dp</item>
		<item name="shapeAppearanceOverlay">@style/shape_btn_rounded</item>
	</style>

	<style name="btn_m3" parent="@style/Widget.Material3.Button.Filled" />

	<style name="shape_btn_rounded">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">12dp</item>
	</style>

	<!-- ================== DIALOG ================== -->
	<!-- 🔷 Overlay para AppBar -->
	<style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

	<!-- 🔶 Overlay para popups -->
	<style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

	<!-- ⚙️ Diálogo personalizado (para MaterialAlertDialogBuilder) -->
	<style name="AppTheme.CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:backgroundDimEnabled">true</item>
		<item name="android:backgroundDimAmount">0.5</item>
		<item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Custom.Medium</item>
	</style>

	<!-- 🟢 Esquinas redondeadas personalizadas -->
	<style name="ShapeAppearanceOverlay.Custom.Medium" parent="ShapeAppearance.Material3.MediumComponent">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">16dp</item>
	</style>

	<!-- Alias adicional para compatibilidad con referencias antiguas -->
	<style name="ShapeAppearanceOverlay.Custom" parent="ShapeAppearance.Material3.MediumComponent">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">16dp</item>
	</style>

	<!-- 🔧 Define un estilo vacío para ShapeAppearanceOverlay (resuelve tu error actual) -->
	<style name="ShapeAppearanceOverlay">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">8dp</item>
	</style>


	<!-- ================== INPUTS ================== -->
	<style name="entry_m3" parent="@style/Widget.Material3.TextInputEditText.OutlinedBox">
		<item name="android:textColor">@color/md_theme_onSurface</item>
		<item name="android:backgroundTint">@color/md_theme_surfaceVariant</item>
		<item name="shapeAppearanceOverlay">@style/shape_entry_rounded</item>
		<item name="android:padding">12dp</item>
		<item name="android:layout_height">56dp</item>
	</style>

	<style name="shape_entry_rounded">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">8dp</item>
	</style>

	<style name="TextInputLayout_Outlined" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
		<item name="android:textColorHint">@color/hint_color</item>
		<item name="boxBackgroundMode">outline</item>
		<item name="boxStrokeColor">@color/outline_active</item>
		<item name="boxStrokeWidth">1.5dp</item>
		<item name="boxStrokeWidthFocused">2dp</item>
		<item name="boxCornerRadiusTopStart">12dp</item>
		<item name="boxCornerRadiusTopEnd">12dp</item>
		<item name="boxCornerRadiusBottomStart">12dp</item>
		<item name="boxCornerRadiusBottomEnd">12dp</item>
	</style>

	<!-- ================== SPINNER ================== -->
	<style name="spinner_moderno" parent="@style/Widget.AppCompat.Spinner">
		<item name="android:background">@drawable/bg_spinner_moderno</item>
		<item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
		<item name="android:padding">8dp</item>
		<item name="android:popupBackground">@color/md_theme_surfaceContainer</item>
		<item name="android:dropDownVerticalOffset">4dp</item>
	</style>

	<!-- ================== CARDS ================== -->
	<style name="card_m3" parent="@style/Widget.Material3.CardView.Elevated">
		<item name="cardBackgroundColor">@color/md_theme_surfaceContainer</item>
		<item name="cardCornerRadius">12dp</item>
		<item name="cardElevation">4dp</item>
		<item name="contentPadding">12dp</item>
	</style>

	<!-- ================== TOOLBAR ================== -->
	<!--<style name="ToolbarStyle" parent="@style/Widget.Material3.Toolbar">
		<item name="android:background">@color/md_theme_surfaceContainer</item>
		<item name="titleTextColor">@color/md_theme_onSurface</item>
		<item name="subtitleTextColor">@color/md_theme_onSurface</item>
	</style>-->
	<style name="ToolbarStyle" parent="@style/Widget.Material3.Toolbar">
		<item name="android:background">@color/md_theme_surfaceContainer</item>
		<item name="titleTextColor">@color/md_theme_onSurface</item>
		<item name="subtitleTextColor">@color/md_theme_onSurface</item>

		<!-- Mejoras clave -->
		<item name="android:elevation">0dp</item>
		<item name="maxButtonHeight">48dp</item>

		<!-- Tint para íconos -->
		<item name="navigationIconTint">@color/md_theme_onSurface</item>
		<item name="iconTint">@color/md_theme_onSurface</item>

		<!-- Tipografía Material 3 -->
		<item name="titleTextAppearance">@style/TextAppearance.Material3.TitleMedium</item>
		<item name="subtitleTextAppearance">@style/TextAppearance.Material3.BodyMedium</item>

		<!-- Para mejor integración con sistema -->
		<item name="android:fitsSystemWindows">true</item>

		<!-- Padding interno consistente -->
		<item name="contentInsetStart">0dp</item>
		<item name="contentInsetEnd">0dp</item>

		<item name="cornerRadius">12dp</item>
		<item name="android:clipToOutline">true</item>

		<item name="rippleColor">@color/md_theme_onSurface</item>
	</style>

	<!-- ================== LABELS ================== -->
	<style name="label_primary" parent="@style/TextAppearance.Material3.TitleMedium">
		<item name="android:textColor">@color/md_theme_onBackground</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="label_secondary" parent="@style/TextAppearance.Material3.BodyMedium">
		<item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
	</style>

	<style name="label_error" parent="@style/TextAppearance.Material3.BodyMedium">
		<item name="android:textColor">@color/md_theme_onError</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="label_dialog" parent="@style/TextAppearance.Material3.TitleMedium">
		<item name="android:textColor">?attr/colorOnSurfaceInverse</item>
		<item name="android:textStyle">bold</item>
	</style>




</resources>
